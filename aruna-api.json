  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "CRON_SECRET",
      "value": "<your-cron-secret>",
      "type": "string"
    }
  ],
